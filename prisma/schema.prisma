generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN_ADS
  ADMIN_MARKETPLACE
  FINANCE
}

enum ChannelType {
  TOKOPEDIA
  SHOPEE
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  SKIPPED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(OWNER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes DailyNote[]
  tasks OptimizationTask[]
}

model Product {
  id            String   @id @default(cuid())
  sku           String   @unique
  name          String
  category      String?
  costPrice     Decimal  @db.Decimal(12, 2)
  sellPrice     Decimal  @db.Decimal(12, 2)
  marginValue   Decimal? @db.Decimal(12, 2)
  marginPercent Decimal? @db.Decimal(5, 2)
  stock         Int      @default(0)
  targetRoas    Decimal? @db.Decimal(8, 2)
  targetAcos    Decimal? @db.Decimal(8, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  metricsDaily ProductMetricDaily[]
  orderItems   OrderItem[]
  tasks        OptimizationTask[]
}

model Store {
  id          String      @id @default(cuid())
  name        String
  channelType ChannelType
  externalId  String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  orders Order[]
}

model Campaign {
  id          String      @id @default(cuid())
  channelType ChannelType
  externalId  String?
  name        String
  status      String?
  dailyBudget Decimal?    @db.Decimal(12, 2)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  metricsDaily CampaignMetricDaily[]
}

model CampaignMetricDaily {
  id              String   @id @default(cuid())
  campaignId      String
  metricDate      DateTime
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  cost            Decimal  @default(0) @db.Decimal(12, 2)
  conversions     Int      @default(0)
  conversionValue Decimal  @default(0) @db.Decimal(12, 2)
  roas            Decimal? @db.Decimal(8, 2)
  acos            Decimal? @db.Decimal(8, 2)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, metricDate])
}

model ProductMetricDaily {
  id             String      @id @default(cuid())
  productId      String
  channelType    ChannelType
  metricDate     DateTime
  views          Int         @default(0)
  clicks         Int         @default(0)
  ordersCount    Int         @default(0)
  unitsSold      Int         @default(0)
  revenue        Decimal     @default(0) @db.Decimal(12, 2)
  adSpend        Decimal     @default(0) @db.Decimal(12, 2)
  profitEstimate Decimal?    @db.Decimal(12, 2)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, channelType, metricDate])
}

model Order {
  id          String   @id @default(cuid())
  storeId     String
  externalId  String?  @unique
  orderDate   DateTime
  status      String
  subtotal    Decimal  @default(0) @db.Decimal(12, 2)
  shippingFee Decimal  @default(0) @db.Decimal(12, 2)
  totalAmount Decimal  @default(0) @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items OrderItem[]
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String
  qty         Int
  sellPrice   Decimal  @db.Decimal(12, 2)
  costPrice   Decimal  @db.Decimal(12, 2)
  lineRevenue Decimal  @db.Decimal(12, 2)
  lineProfit  Decimal? @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model OptimizationTask {
  id                 String     @id @default(cuid())
  taskDate           DateTime
  taskType           String
  priority           String
  recommendationText String
  status             TaskStatus @default(OPEN)
  assigneeId         String?
  productId          String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  assignee User?    @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  product  Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model DailyNote {
  id        String   @id @default(cuid())
  noteDate  DateTime
  content   String
  authorId  String
  createdAt DateTime @default(now())

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}
